<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Patty</title>
  <link rel="icon" type="image/png" href="/static/icon.png">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/"><img src="/static/icon.png" alt="">Patty</a>
    <button class="nav-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-nav">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav id="primary-nav" class="primary-nav">
      <a href="/">Dashboard</a>
      <a href="/profiles/new">Create</a>
      <a href="/import">Import</a>
      <a href="/settings">Settings</a>
      <a href="/logs">Logs</a>
      <form method="post" action="/logout" class="inline">
        <input type="hidden" name="csrf_token" value="<%= csrf %>">
        <button class="linklike" type="submit">Logout</button>
      </form>
    </nav>
  </header>
  <main>
    <% if f = flash %>
      <div class="flash flash-<%= f[0] %>"><%= nl2br(f[1]) %></div>
    <% end %>
    <%= content %>
  </main>
  <script src="/static/app.js"></script>
</body>
</html>
