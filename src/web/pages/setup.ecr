<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Patty — First-run Setup</title>
  <link rel="icon" type="image/png" href="/static/icon.png">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <div class="auth-wrap">
    <h1 class="auth-title"><img src="/static/icon.png" alt="">Welcome to Patty</h1>
    <p class="empty">Set an admin password to protect the dashboard.</p>
    <% if error %>
      <div class="flash flash-error"><%= h(error.to_s) %></div>
    <% end %>
    <div class="panel">
      <form method="post" action="/setup">
        <input type="hidden" name="csrf_token" value="<%= csrf_form %>">
        <label for="password">Admin password</label>
        <input type="password" id="password" name="password" autocomplete="new-password" autofocus required minlength="8">
        <label for="password_confirm">Confirm password</label>
        <input type="password" id="password_confirm" name="password_confirm" autocomplete="new-password" required minlength="8">
        <p class="hint">Use a long, unique passphrase. Eight characters is only the minimum.</p>
        <p style="margin-top: 1rem;">
          <button class="btn primary" type="submit">Set Password</button>
        </p>
      </form>
    </div>
  </div>
</body>
</html>
